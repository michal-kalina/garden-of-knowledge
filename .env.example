# Copy to .env and adjust. File .env is NOT committed.
POSTGRES_USER=gok
POSTGRES_PASSWORD=gok_dev_password
POSTGRES_DB=gok
DATABASE_URL=postgres://gok:gok_dev_password@postgres:5432/gok?sslmode=disable

MINIO_ROOT_USER=gok
MINIO_ROOT_PASSWORD=gok_dev_password
# host:port without scheme; scheme is controlled by S3_USE_SSL
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=gok
S3_SECRET_KEY=gok_dev_password
S3_BUCKET=documents

# Key for the model API (Phase 1+). Never commit a real key.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Key for the Voyage AI embeddings API. Never commit a real key.
# If empty, EMBEDDINGS_PROVIDER defaults to "fake" (deterministic
# pseudo-embeddings for offline dev; retrieval quality is meaningless).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Optional cross-encoder rerank pass after hybrid search. Disabled by
# default (adds latency/cost); uses the same VOYAGE_API_KEY as embeddings.
RERANK_PROVIDER=
RERANK_MODEL=rerank-2.5
# Optional: "voyage" or "fake". Auto-selected from VOYAGE_API_KEY if unset.
EMBEDDINGS_PROVIDER=

# Signs session tokens (HS256). Use a long random string; the compose default
# is for local development ONLY.
AUTH_SECRET=dev_only_secret_change_me

# Distributed tracing (OpenTelemetry). Empty = disabled, zero overhead.
# Point at a local collector for a quick demo, e.g. Jaeger:
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
#   OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
#   OTEL_EXPORTER_OTLP_INSECURE=true
# ...then view traces at http://localhost:16686.
# For a hosted backend (Langfuse, Honeycomb, etc.), use its current OTLP/HTTP
# ingestion endpoint and auth per that provider's docs — this project speaks
# plain OTLP, not any vendor's SDK, so nothing here is Langfuse-specific.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=
OTEL_EXPORTER_OTLP_URL_PATH=
