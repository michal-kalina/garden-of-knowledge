# Copy to .env and adjust. File .env is NOT committed.
POSTGRES_USER=gok
POSTGRES_PASSWORD=gok_dev_password
POSTGRES_DB=gok
DATABASE_URL=postgres://gok:gok_dev_password@postgres:5432/gok?sslmode=disable

MINIO_ROOT_USER=gok
MINIO_ROOT_PASSWORD=gok_dev_password
# host:port without scheme; scheme is controlled by S3_USE_SSL
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=gok
S3_SECRET_KEY=gok_dev_password
S3_BUCKET=documents

# Key for the model API (Phase 1+). Never commit a real key.
ANTHROPIC_API_KEY=
