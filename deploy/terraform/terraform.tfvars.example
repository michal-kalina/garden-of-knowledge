# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored — it's fine for it to contain your IP and
# email; it should never contain secrets, and doesn't need to here.

# Find yours: curl -s ifconfig.me
admin_cidr = "YOUR.IP.ADDRESS.HERE/32"

# cat ~/.ssh/id_ed25519.pub  (generate one first if you don't have it:
# ssh-keygen -t ed25519 -C "gok-deploy")
ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"

budget_alert_email = "you@example.com"

# Optional overrides — defaults are already budget-conscious.
# aws_region    = "eu-central-1"
# instance_type = "t4g.small"
